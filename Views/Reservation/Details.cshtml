```cshtml
@model BUA_project.Models.Reservation

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Reservation Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Reservation Details</h1>

        <a asp-action="Index" class="btn btn-secondary">
            Back to List
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h4 class="mb-0">Reservation Information</h4>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Reservation ID:</strong>
                    <div>@Model.ReservationId</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Status:</strong>
                    <div>
                        @switch (Model.Status)
                        {
                            case "Pending":
                        <span class="badge bg-warning text-dark">Pending</span>
                                break;

                            case "Approved":
                        <span class="badge bg-success">Approved</span>
                                break;

                            case "Rejected":
                        <span class="badge bg-danger">Rejected</span>
                                break;

                            case "Cancelled":
                        <span class="badge bg-secondary">Cancelled</span>
                                break;

                            case "Dispatched":
                        <span class="badge bg-info text-dark">Dispatched</span>
                                break;

                            case "Active":
                        <span class="badge bg-primary">Active</span>
                                break;

                            case "Completed":
                        <span class="badge bg-success">Completed</span>
                                break;

                            default:
                        <span class="badge bg-secondary">@Model.Status</span>
                                break;
                        }
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Start:</strong>
                    <div>@Model.StartDateTime</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>End:</strong>
                    <div>@Model.EndDateTime</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Origin:</strong>
                    <div>@Model.Origin</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Destination:</strong>
                    <div>@Model.Destination</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Passengers:</strong>
                    <div>@Model.Passengers</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Load:</strong>
                    <div>@Model.Load</div>
                </div>

                <div class="col-md-12 mb-3">
                    <strong>Purpose:</strong>
                    <div>@Model.Purpose</div>
                </div>

            </div>
        </div>
    </div>

    @if (Model.Vehicle != null)
    {
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h4 class="mb-0">Vehicle</h4>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-4">
                    <strong>Brand:</strong>
                    <div>@Model.Vehicle.Brand</div>
                </div>

                <div class="col-md-4">
                    <strong>Model:</strong>
                    <div>@Model.Vehicle.Model</div>
                </div>

                <div class="col-md-4">
                    <strong>Plate Number:</strong>
                    <div>@Model.Vehicle.PlateNumber</div>
                </div>

                <div class="col-md-4 mt-3">
                    <strong>Type:</strong>
                    <div>@Model.Vehicle.Type</div>
                </div>

                <div class="col-md-4 mt-3">
                    <strong>Fuel Type:</strong>
                    <div>@Model.Vehicle.FuelType</div>
                </div>

                <div class="col-md-4 mt-3">
                    <strong>Seats:</strong>
                    <div>@Model.Vehicle.Seats</div>
                </div>

            </div>
        </div>
    </div>
    }

    @if (Model.Driver != null)
    {
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h4 class="mb-0">Driver</h4>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-4">
                    <strong>Name:</strong>
                    <div>@Model.Driver.Name</div>
                </div>

                <div class="col-md-4">
                    <strong>License Number:</strong>
                    <div>@Model.Driver.LicenseNumber</div>
                </div>

                <div class="col-md-4">
                    <strong>Qualification:</strong>
                    <div>@Model.Driver.QualificationStatus</div>
                </div>

            </div>
        </div>
    </div>
    }

    @if (Model.User != null)
    {
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h4 class="mb-0">Requester</h4>
        </div>

        <div class="card-body">
            <strong>Name:</strong>
            <div>@Model.User.Name</div>

            <strong class="d-block mt-3">Email:</strong>
            <div>@Model.User.Email</div>
        </div>
    </div>
    }

    @if (Model.Trip != null)
    {
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h4 class="mb-0">Trip Information</h4>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-4">
                    <strong>Trip Status:</strong>
                    <div>@Model.Trip.Status</div>
                </div>

                <div class="col-md-4">
                    <strong>Started At:</strong>
                    <div>@Model.Trip.StartedAt</div>
                </div>

                <div class="col-md-4">
                    <strong>Completed At:</strong>
                    <div>
                        @(Model.Trip.CompletedAt?.ToString() ?? "Not Completed")
                    </div>
                </div>

                <div class="col-md-4 mt-3">
                    <strong>Actual Distance:</strong>
                    <div>@Model.Trip.ActualDistanceKm km</div>
                </div>

                <div class="col-md-4 mt-3">
                    <strong>Actual Fuel:</strong>
                    <div>@Model.Trip.ActualFuelLiters L</div>
                </div>

                <div class="col-md-4 mt-3">
                    <strong>Actual Fuel Cost:</strong>
                    <div>@Model.Trip.ActualFuelCost</div>
                </div>

            </div>
        </div>
    </div>
    }

</div>
```
