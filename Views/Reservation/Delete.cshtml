```cshtml
@model BUA_project.Models.Reservation

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Reservation";
}

<h1>Delete Reservation</h1>

<h3>Are you sure you want to delete this reservation?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Start</dt>
        <dd class="col-sm-10">@Model.StartDateTime</dd>

        <dt class="col-sm-2">End</dt>
        <dd class="col-sm-10">@Model.EndDateTime</dd>

        <dt class="col-sm-2">Origin</dt>
        <dd class="col-sm-10">@Model.Origin</dd>

        <dt class="col-sm-2">Destination</dt>
        <dd class="col-sm-10">@Model.Destination</dd>

        <dt class="col-sm-2">Passengers</dt>
        <dd class="col-sm-10">@Model.Passengers</dd>

        <dt class="col-sm-2">Purpose</dt>
        <dd class="col-sm-10">@Model.Purpose</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="ReservationId" />

        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
```
