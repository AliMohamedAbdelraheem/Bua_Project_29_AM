@model IEnumerable<BUA_project.Models.Reservation>

    @{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Reservations";
    }

    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>Reservations</h1>
                <p class="text-muted mb-0">
                    View and monitor fleet reservations.
                </p>
            </div>
        </div>

        <!-- Filters -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <form asp-action="Index"
                      method="get"
                      class="row g-3">

                    <!-- Search -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search by requester, origin, destination, purpose or ID..." />
                    </div>

                    <!-- Status -->
                    <div class="col-md-4">
                        <label class="form-label">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All Statuses
                            </option>

                            @foreach (var item in ViewBag.Statuses)
                        {
                            <option value="@item"
                                    selected="@(ViewBag.SelectedStatus == item)">
                                @item
                            </option>
                        }

                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="col-md-2 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Filter
                        </button>

                    </div>

                </form>

            </div>
        </div>


        <!-- Reservations Table -->
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered table-striped align-middle">

                        <thead>
                            <tr>

                                <th>ID</th>

                                <th>Start</th>

                                <th>End</th>

                                <th>Origin</th>

                                <th>Destination</th>

                                <th>Passengers</th>

                                <th>Load</th>

                                <th>Purpose</th>

                                <th>Status</th>

                                <th>Vehicle</th>

                                <th>Requester</th>

                                <th>Driver</th>

                                <th>Actions</th>

                            </tr>
                        </thead>

                        <tbody>

                            @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="13"
                                    class="text-center text-muted py-4">

                                    No reservations found.

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var reservation in Model)
                            {
                            <tr>

                                <td>
                                    #@reservation.ReservationId
                                </td>

                                <td>
                                    @reservation.StartDateTime.ToString(
                                        "dd/MM/yyyy hh:mm tt")
                                </td>

                                <td>
                                    @reservation.EndDateTime.ToString(
                                        "dd/MM/yyyy hh:mm tt")
                                </td>

                                <td>
                                    @reservation.Origin
                                </td>

                                <td>
                                    @reservation.Destination
                                </td>

                                <td>
                                    @reservation.Passengers
                                </td>

                                <td>
                                    @reservation.Load
                                </td>

                                <td>
                                    @reservation.Purpose
                                </td>

                                <td>
                                    @switch (reservation.Status)
                                        {
                                            case "Pending":
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                                break;

                                            case "Approved":
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                                break;

                                            case "Rejected":
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                                break;

                                            case "Cancelled":
                                    <span class="badge bg-secondary">
                                        Cancelled
                                    </span>
                                                break;

                                            case "Dispatched":
                                    <span class="badge bg-primary">
                                        Dispatched
                                    </span>
                                                break;

                                            case "Active":
                                    <span class="badge bg-info text-dark">
                                        Active
                                    </span>
                                                break;

                                            case "Completed":
                                    <span class="badge bg-dark">
                                        Completed
                                    </span>
                                                break;

                                            default:
                                    <span class="badge bg-secondary">
                                        @reservation.Status
                                    </span>
                                                break;
                                        }
                                </td>

                                <td>
                                    @if (reservation.Vehicle != null)
                                        {
                                    @($"{reservation.Vehicle.Brand} {reservation.Vehicle.Model}")
                                        }
                                        else
                                        {
                                    <span class="text-muted">
                                        Not assigned
                                    </span>
                                        }
                                </td>

                                <td>
                                    @if (reservation.User != null)
                                        {
                                    @reservation.User.Name
                                        }
                                        else
                                        {
                                    <span class="text-muted">
                                        Unknown
                                    </span>
                                        }
                                </td>

                                <td>
                                    @if (reservation.Driver != null)
                                        {
                                    @reservation.Driver.Name
                                        }
                                        else
                                        {
                                    <span class="text-muted">
                                        Not assigned
                                    </span>
                                        }
                                </td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@reservation.ReservationId"
                                       class="btn btn-info btn-sm">

                                        Details

                                    </a>
                                </td>

                            </tr>
                            }
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>