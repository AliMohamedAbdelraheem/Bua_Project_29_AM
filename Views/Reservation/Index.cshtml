```cshtml
@model IEnumerable<BUA_project.Models.Reservation>

    @{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Reservations";
    }

    <div class="container-fluid mt-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Reservations</h1>

            <a asp-action="Create" class="btn btn-primary">
                + Create Reservation
            </a>
        </div>

        <form asp-action="Index" method="get" class="row g-3 mb-4">

            <div class="col-md-5">
                <label class="form-label">Search</label>
                <input type="text"
                       name="search"
                       value="@Context.Request.Query["search"]"
                       class="form-control"
                       placeholder="Origin, destination, purpose..." />
            </div>

            <div class="col-md-3">
                <label class="form-label">Status</label>

                <select name="status" class="form-select">
                    <option value="">All Statuses</option>

                    @foreach (var status in new[]
                {
                    "Pending",
                    "Approved",
                    "Rejected",
                    "Dispatched",
                    "Active",
                    "Completed",
                    "Cancelled"
                })
                {
                    if (Context.Request.Query["status"] == status)
                    {
                    <option value="@status" selected>@status</option>
                    }
                    else
                    {
                    <option value="@status">@status</option>
                    }
                }
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-secondary w-100">
                    Filter
                </button>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    Clear
                </a>
            </div>

        </form>

        <div class="card shadow-sm">
            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover table-bordered mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Origin</th>
                                <th>Destination</th>
                                <th>Passengers</th>
                                <th>Load</th>
                                <th>Purpose</th>
                                <th>Status</th>
                                <th>Vehicle</th>
                                <th>Requester</th>
                                <th>Driver</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ReservationId</td>

                                <td>
                                    @item.StartDateTime.ToString("yyyy-MM-dd HH:mm")
                                </td>

                                <td>
                                    @item.EndDateTime.ToString("yyyy-MM-dd HH:mm")
                                </td>

                                <td>@item.Origin</td>

                                <td>@item.Destination</td>

                                <td>@item.Passengers</td>

                                <td>@item.Load</td>

                                <td>@item.Purpose</td>

                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Pending":
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                            break;

                                        case "Approved":
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                            break;

                                        case "Rejected":
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                            break;

                                        case "Dispatched":
                                    <span class="badge bg-info text-dark">
                                        Dispatched
                                    </span>
                                            break;

                                        case "Active":
                                    <span class="badge bg-primary">
                                        Active
                                    </span>
                                            break;

                                        case "Completed":
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                            break;

                                        case "Cancelled":
                                    <span class="badge bg-secondary">
                                        Cancelled
                                    </span>
                                            break;

                                        default:
                                    <span class="badge bg-secondary">
                                        @item.Status
                                    </span>
                                            break;
                                    }
                                </td>

                                <td>
                                    @if (item.Vehicle != null)
                                    {
                                    @($"{item.Vehicle.Brand} {item.Vehicle.Model}")
                                    }
                                    else
                                    {
                                    <span>N/A</span>
                                    }
                                </td>

                                <td>
                                    @if (item.User != null)
                                    {
                                    @item.User.Name
                                    }
                                    else
                                    {
                                    <span>N/A</span>
                                    }
                                </td>

                                <td>
                                    @if (item.Driver != null)
                                    {
                                    @item.Driver.Name
                                    }
                                    else
                                    {
                                    <span>Not Assigned</span>
                                    }
                                </td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@item.ReservationId"
                                       class="btn btn-sm btn-info">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>

    </div>
    ```
