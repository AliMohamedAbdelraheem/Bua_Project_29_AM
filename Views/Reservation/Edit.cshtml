```cshtml
@model BUA_project.Models.Reservation

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Reservation";
}

<h1>Edit Reservation</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ReservationId" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="StartDateTime" class="control-label"></label>
        <input asp-for="StartDateTime" class="form-control" />
        <span asp-validation-for="StartDateTime" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="EndDateTime" class="control-label"></label>
        <input asp-for="EndDateTime" class="form-control" />
        <span asp-validation-for="EndDateTime" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Origin" class="control-label"></label>
        <input asp-for="Origin" class="form-control" />
        <span asp-validation-for="Origin" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Destination" class="control-label"></label>
        <input asp-for="Destination" class="form-control" />
        <span asp-validation-for="Destination" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Passengers" class="control-label"></label>
        <input asp-for="Passengers" class="form-control" />
        <span asp-validation-for="Passengers" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Load" class="control-label"></label>
        <input asp-for="Load" class="form-control" step="0.01" />
        <span asp-validation-for="Load" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Purpose" class="control-label"></label>
        <input asp-for="Purpose" class="form-control" />
        <span asp-validation-for="Purpose" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Status" class="control-label"></label>
        <select asp-for="Status" class="form-control">
            <option value="Pending">Pending</option>
            <option value="Approved">Approved</option>
            <option value="Rejected">Rejected</option>
            <option value="Dispatched">Dispatched</option>
            <option value="Active">Active</option>
            <option value="Completed">Completed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="VehicleId" class="control-label">Vehicle</label>
        <select asp-for="VehicleId" class="form-control"
                asp-items="@(new SelectList(ViewBag.VehicleId, "VehicleId", "Model"))">
        </select>
        <span asp-validation-for="VehicleId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="UserId" class="control-label">Requester</label>
        <select asp-for="UserId" class="form-control"
                asp-items="@(new SelectList(ViewBag.UserId, "UserId", "Name"))">
        </select>
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="DriverId" class="control-label">Driver</label>
        <select asp-for="DriverId" class="form-control"
                asp-items="@(new SelectList(ViewBag.DriverId, "DriverId", "Name"))">
            <option value="">-- No Driver --</option>
        </select>
        <span asp-validation-for="DriverId" class="text-danger"></span>
    </div>

    <div class="mt-3">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
```
