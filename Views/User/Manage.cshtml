@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

@model BUA_project.Models.User

@{
    ViewData["Title"] = "Manage User";
}

<div class="container mt-4">

    @if (TempData["ManageError"] != null)
    {
    <div class="alert alert-danger">
        @TempData["ManageError"]
    </div>
    }

    @if (TempData["ManageSuccess"] != null)
    {
    <div class="alert alert-success">
        @TempData["ManageSuccess"]
    </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage User</h2>
            <p class="text-muted mb-0">
                Manage user role
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            Back to Users
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Role Management</h5>
        </div>

        <div class="card-body">

            <div class="mb-4">
                <strong>Name:</strong>
                @Model.Name
            </div>

            <div class="mb-4">
                <strong>Email:</strong>
                @Model.Email
            </div>

            <div class="mb-4">
                <strong>Current Role:</strong>
                <span class="badge bg-primary">
                    @Model.Role
                </span>
            </div>

            <form asp-action="Manage" method="post">

                <input type="hidden"
                       name="UserId"
                       value="@Model.UserId" />

                <div class="mb-4">

                    <label for="roleSelect"
                           class="form-label fw-bold">
                        Change Role
                    </label>

                    <select id="roleSelect"
                            name="NewRole"
                            class="form-select"
                            required>

                        <option value="Requester"
                                selected="@(Model.Role == "Requester" || Model.Role == "User")">
                            Requester
                        </option>

                        <option value="Dispatcher"
                                selected="@(Model.Role == "Dispatcher")">
                            Dispatcher
                        </option>

                        <option value="Driver"
                                selected="@(Model.Role == "Driver")">
                            Driver
                        </option>

                        <option value="Admin"
                                selected="@(Model.Role == "Admin")">
                            Admin
                        </option>

                    </select>

                </div>

                <!-- Driver Information -->
                <div id="driverSection" style="display: none;">

                    <div class="border rounded p-4 mb-4">

                        <h5 class="mb-3">
                            Driver Information
                        </h5>

                        <div class="mb-3">

                            <label class="form-label">
                                License Number
                            </label>

                            <input type="text"
                                   name="LicenseNumber"
                                   class="form-control"
                                   value="@Model.Driver?.LicenseNumber" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Qualification Status
                            </label>

                            <input type="text"
                                   name="QualificationStatus"
                                   class="form-control"
                                   value="@Model.Driver?.QualificationStatus" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Qualification Valid Until
                            </label>

                            <input type="date"
                                   name="QualificationValidUntil"
                                   class="form-control"
                                   value="@Model.Driver?.QualificationValidUntil.ToString(" yyyy-MM-dd")" />

                        </div>

                    </div>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

<script>

    const roleSelect = document.getElementById("roleSelect");
    const driverSection = document.getElementById("driverSection");

    function updateDriverSection() {

        if (roleSelect.value === "Driver") {
            driverSection.style.display = "block";
        }
        else {
            driverSection.style.display = "none";
        }

    }

    roleSelect.addEventListener("change", updateDriverSection);

    updateDriverSection();

</script>