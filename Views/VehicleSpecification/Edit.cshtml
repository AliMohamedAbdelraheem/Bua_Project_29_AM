@model BUA_project.Models.VehicleSpecification

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Vehicle Specification";
}

<div class="container-fluid py-4">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Edit Vehicle Specification
        </h2>

        <p class="text-muted mb-0">
            Update the technical specifications.
        </p>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="VehicleSpecificationId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="NominalLPer100Km"
                               class="form-label">
                            Fuel Consumption (L/100 km)
                        </label>

                        <input asp-for="NominalLPer100Km"
                               class="form-control"
                               type="number"
                               step="0.1"
                               min="0" />

                        <span asp-validation-for="NominalLPer100Km"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="TankCapacity"
                               class="form-label">
                            Tank Capacity (L)
                        </label>

                        <input asp-for="TankCapacity"
                               class="form-control"
                               type="number"
                               step="0.1"
                               min="0" />

                        <span asp-validation-for="TankCapacity"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Accessibility"
                               class="form-label">
                            Accessibility
                        </label>

                        <select asp-for="Accessibility"
                                class="form-select">

                            <option value="Standard">
                                Standard
                            </option>

                            <option value="Wheelchair Accessible">
                                Wheelchair Accessible
                            </option>

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Transmission"
                               class="form-label">
                            Transmission
                        </label>

                        <select asp-for="Transmission"
                                class="form-select">

                            <option value="Automatic">
                                Automatic
                            </option>

                            <option value="Manual">
                                Manual
                            </option>

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="AllowedLoad"
                               class="form-label">
                            Allowed Load (kg)
                        </label>

                        <input asp-for="AllowedLoad"
                               class="form-control"
                               type="number"
                               step="0.1"
                               min="0" />

                        <span asp-validation-for="AllowedLoad"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary ms-2">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}