@{
    Layout = "~/Views/Dispatcher/Shared/_DispatcherLayout.cshtml";
    ViewData["Title"] = "Dispatcher Dashboard";
}


@model BUA_project.Models.ViewModels.DispatcherDashboardViewModel

@{
    Layout = "~/Views/Dispatcher/Shared/_DispatcherLayout.cshtml";
    ViewData["Title"] = "Dispatcher Dashboard";
}

<div class="container-fluid mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">Dispatcher Dashboard</h1>
        <p class="text-muted">
            Overview of reservations, vehicles, drivers, and active trips.
        </p>
    </div>

    <!-- Dashboard Cards -->
    <div class="row g-4 mb-5">

        <!-- Pending Requests -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Pending Requests</h6>

                    <h2 class="fw-bold mt-2">
                        @Model.PendingRequestsCount
                    </h2>

                    <a asp-controller="Dispatcher"
                       asp-action="Index"
                       class="btn btn-sm btn-primary mt-2">
                        View Requests
                    </a>
                </div>
            </div>
        </div>

        <!-- Available Vehicles -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Available Vehicles</h6>

                    <h2 class="fw-bold mt-2">
                        @Model.AvailableVehiclesCount
                    </h2>
                </div>
            </div>
        </div>

        <!-- Available Drivers -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Available Drivers</h6>

                    <h2 class="fw-bold mt-2">
                        @Model.AvailableDriversCount
                    </h2>
                </div>
            </div>
        </div>

        <!-- Active Trips -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Active Trips</h6>

                    <h2 class="fw-bold mt-2">
                        @Model.ActiveTripsCount
                    </h2>

                </div>
            </div>
        </div>

    </div>


    <!-- Recent Pending Requests -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                Recent Pending Requests
            </h5>
        </div>

        <div class="card-body">

            @if (Model.RecentPendingRequests.Any())
            {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Requester</th>
                            <th>Vehicle</th>
                            <th>Origin</th>
                            <th>Destination</th>
                            <th>Start</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var reservation in Model.RecentPendingRequests)
                            {
                        <tr>

                            <td>
                                #@reservation.ReservationId
                            </td>

                            <td>
                                @reservation.User?.Name
                            </td>

                            <td>
                                @reservation.Vehicle?.Brand
                                @reservation.Vehicle?.Model
                            </td>

                            <td>
                                @reservation.Origin
                            </td>

                            <td>
                                @reservation.Destination
                            </td>

                            <td>
                                @reservation.StartDateTime.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                <a asp-controller="Dispatcher"
                                   asp-action="Details"
                                   asp-route-id="@reservation.ReservationId"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            </td>

                        </tr>
                            }

                    </tbody>

                </table>

            </div>
            }
            else
            {
            <div class="text-center py-4">

                <p class="text-muted mb-0">
                    No pending requests at the moment.
                </p>

            </div>
            }

        </div>

    </div>

</div>