@model BUA_project.Models.ViewModels.DispatcherDashboardViewModel

@{
    Layout = "~/Views/Dispatcher/Shared/_DispatcherLayout.cshtml";
    ViewData["Title"] = "Dispatcher Dashboard";
}

<link rel="stylesheet" href="~/css/dispatcher-dashboard.css" />

<div class="dispatcher-dashboard">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="dispatcher-page-header">

        <div>
            <p class="dispatcher-eyebrow">
                Fleet Operations
            </p>

            <h1>
                Dispatcher Dashboard
            </h1>

            <p class="dispatcher-subtitle">
                Overview of reservations, vehicles, drivers, and active trips.
            </p>
        </div>

    </div>


    <!-- =========================================================
         DASHBOARD METRICS
         ========================================================= -->

    <div class="dispatcher-metrics-grid">

        <!-- Pending Requests -->

        <div class="dispatcher-metric-card">

            <div class="dispatcher-metric-top">

                <span class="dispatcher-metric-label">
                    Pending Requests
                </span>

                <span class="dispatcher-metric-number">
                    @Model.PendingRequestsCount
                </span>

            </div>

            <div class="dispatcher-metric-footer">

                <span>
                    Requests waiting for review
                </span>

                <a asp-controller="Dispatcher"
                   asp-action="Index"
                   class="dispatcher-card-link">

                    View Requests

                </a>

            </div>

        </div>


        <!-- Available Vehicles -->

        <div class="dispatcher-metric-card">

            <div class="dispatcher-metric-top">

                <span class="dispatcher-metric-label">
                    Available Vehicles
                </span>

                <span class="dispatcher-metric-number">
                    @Model.AvailableVehiclesCount
                </span>

            </div>

            <div class="dispatcher-metric-footer">

                <span>
                    Vehicles ready for reservation
                </span>

            </div>

        </div>


        <!-- Available Drivers -->

        <div class="dispatcher-metric-card">

            <div class="dispatcher-metric-top">

                <span class="dispatcher-metric-label">
                    Available Drivers
                </span>

                <span class="dispatcher-metric-number">
                    @Model.AvailableDriversCount
                </span>

            </div>

            <div class="dispatcher-metric-footer">

                <span>
                    Drivers ready for assignment
                </span>

            </div>

        </div>


        <!-- Active Trips -->

        <div class="dispatcher-metric-card">

            <div class="dispatcher-metric-top">

                <span class="dispatcher-metric-label">
                    Active Trips
                </span>

                <span class="dispatcher-metric-number">
                    @Model.ActiveTripsCount
                </span>

            </div>

            <div class="dispatcher-metric-footer">

                <span>
                    Trips currently in progress
                </span>

                <a asp-controller="Dispatcher"
                   asp-action="ActiveTrips"
                   class="dispatcher-card-link">

                    View Active Trips

                </a>

            </div>

        </div>

    </div>


    <!-- =========================================================
         RECENT PENDING REQUESTS
         ========================================================= -->

    <div class="dispatcher-requests-card">

        <div class="dispatcher-requests-header">

            <div>

                <p class="dispatcher-section-label">
                    Reservations
                </p>

                <h2>
                    Recent Pending Requests
                </h2>

                <p>
                    Review the latest reservation requests awaiting dispatcher action.
                </p>

            </div>

            <div class="dispatcher-request-count">

                @Model.PendingRequestsCount
                <span>
                    pending
                </span>

            </div>

        </div>


        <div class="dispatcher-requests-body">

            @if (Model.RecentPendingRequests != null &&
                 Model.RecentPendingRequests.Any())
            {

                <div class="dispatcher-table-wrapper">

                    <table class="dispatcher-table">

                        <thead>

                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    Requester
                                </th>

                                <th>
                                    Vehicle
                                </th>

                                <th>
                                    Route
                                </th>

                                <th>
                                    Start
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var reservation in Model.RecentPendingRequests)
                            {

                                <tr>

                                    <!-- ID -->

                                    <td>

                                        <span class="reservation-id">
                                            #@reservation.ReservationId
                                        </span>

                                    </td>


                                    <!-- Requester -->

                                    <td>

                                        <div class="requester-cell">

                                            <span class="requester-name">
                                                @reservation.User?.Name
                                            </span>

                                        </div>

                                    </td>


                                    <!-- Vehicle -->

                                    <td>

                                        <div class="vehicle-cell">

                                            <strong>
                                                @reservation.Vehicle?.Brand
                                                @reservation.Vehicle?.Model
                                            </strong>

                                        </div>

                                    </td>


                                    <!-- Route -->

                                    <td>

                                        <div class="route-cell">

                                            <span>
                                                @reservation.Origin
                                            </span>

                                            <span class="route-arrow">
                                                →
                                            </span>

                                            <span>
                                                @reservation.Destination
                                            </span>

                                        </div>

                                    </td>


                                    <!-- Start -->

                                    <td>

                                        <div class="start-cell">

                                            <strong>
                                                @reservation.StartDateTime.ToString("dd/MM/yyyy")
                                            </strong>

                                            <span>
                                                @reservation.StartDateTime.ToString("HH:mm")
                                            </span>

                                        </div>

                                    </td>


                                    <!-- Action -->

                                    <td>

                                        <a asp-controller="Dispatcher"
                                           asp-action="Details"
                                           asp-route-id="@reservation.ReservationId"
                                           class="dispatcher-view-btn">

                                            View

                                        </a>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="dispatcher-empty-state">

                    <div class="dispatcher-empty-icon">

                        <span>
                            —
                        </span>

                    </div>

                    <h3>
                        No Pending Requests
                    </h3>

                    <p>
                        There are currently no reservation requests waiting for approval.
                    </p>

                </div>

            }

        </div>

    </div>

</div>
