@model IEnumerable<BUA_project.Models.Reservation>

    @{
    Layout = "~/Views/Dispatcher/Shared/_DispatcherLayout.cshtml";
    ViewData["Title"] = "Pending Requests";
    }

    <div class="container-fluid mt-4">

        <div class="mb-4">
            <h1 class="fw-bold">Pending Requests</h1>
            <p class="text-muted mb-0">
                Review reservation requests and decide whether to approve or reject them.
            </p>
        </div>

        @if (Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Requester</th>
                                <th>Vehicle</th>
                                <th>Route</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Passengers</th>
                                <th>Load</th>
                                <th>Purpose</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var reservation in Model)
                            {
                            <tr>

                                <td>
                                    @reservation.User?.Name
                                </td>

                                <td>
                                    @reservation.Vehicle?.PlateNumber
                                </td>

                                <td>
                                    <div>
                                        <strong>@reservation.Origin</strong>
                                        <span class="text-muted"> → </span>
                                        <strong>@reservation.Destination</strong>
                                    </div>
                                </td>

                                <td>
                                    @reservation.StartDateTime.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @reservation.EndDateTime.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @reservation.Passengers
                                </td>

                                <td>
                                    @reservation.Load
                                </td>

                                <td>
                                    @reservation.Purpose
                                </td>

                                <td>
                                    <span class="badge bg-warning text-dark">
                                        @reservation.Status
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@reservation.ReservationId"
                                           class="btn btn-info btn-sm">
                                            Details
                                        </a>

                                        <a asp-action="Approve"
                                           asp-route-id="@reservation.ReservationId"
                                           class="btn btn-success btn-sm">
                                            Accept
                                        </a>

                                        <a asp-action="Reject"
                                           asp-route-id="@reservation.ReservationId"
                                           class="btn btn-danger btn-sm">
                                            Reject
                                        </a>

                                    </div>
                                </td>

                            </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">

                <h5 class="fw-bold">
                    No Pending Requests
                </h5>

                <p class="text-muted mb-0">
                    There are currently no reservation requests waiting for approval.
                </p>

            </div>
        </div>
    }

    </div>
