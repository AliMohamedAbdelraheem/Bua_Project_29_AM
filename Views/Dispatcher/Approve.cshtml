@model BUA_project.Models.Reservation

@{
    Layout = "~/Views/Dispatcher/Shared/_DispatcherLayout.cshtml";
    ViewData["Title"] = "Approve Reservation";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">Approve Reservation</h1>

        <p class="text-muted">
            Review the reservation and assign an available vehicle and driver.
        </p>

        @if (!ViewData.ModelState.IsValid)
{
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values
                .SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
            </ul>
        </div>
}
    </div>

    <!-- Reservation Information -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                Reservation Details
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">
                    <strong>Requester</strong>
                    <div>
                        @Model.User?.Name
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Purpose</strong>
                    <div>
                        @Model.Purpose
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Origin</strong>
                    <div>
                        @Model.Origin
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Destination</strong>
                    <div>
                        @Model.Destination
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Start</strong>
                    <div>
                        @Model.StartDateTime.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>End</strong>
                    <div>
                        @Model.EndDateTime.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Passengers</strong>
                    <div>
                        @Model.Passengers
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Load</strong>
                    <div>
                        @Model.Load
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- Assignment -->
    <form asp-action="Approve"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="id"
               value="@Model.ReservationId" />


        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold">
                    Assign Resources
                </h5>
            </div>

            <div class="card-body">

                <div class="row g-4">

                    <!-- Vehicle -->
                    <div class="col-md-6">

                        <label for="vehicleId"
                               class="form-label fw-bold">
                            Vehicle
                        </label>

                        <select name="vehicleId"
                                id="vehicleId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Vehicle --
                            </option>

                            @if (ViewBag.Vehicles != null)
                            {
                                foreach (var vehicle in ViewBag.Vehicles)
                                {
                            <option value="@vehicle.VehicleId">
                                @vehicle.Brand
                                @vehicle.Model
                                -
                                @vehicle.PlateNumber
                                -
                                @vehicle.Seats seats
                            </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- Driver -->
                    <div class="col-md-6">

                        <label for="driverId"
                               class="form-label fw-bold">
                            Driver
                        </label>

                        <select name="driverId"
                                id="driverId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Driver --
                            </option>

                            @if (ViewBag.Drivers != null)
                            {
                                foreach (var driver in ViewBag.Drivers)
                                {
                            <option value="@driver.DriverId">
                                @driver.Name
                                -
                                @driver.LicenseNumber
                            </option>
                                }
                            }

                        </select>

                    </div>

                </div>

            </div>

        </div>


        <!-- Actions -->
        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-success">
                Approve & Assign
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>