@model BUA_project.Models.Reservation

@{
    ViewData["Title"] = "Reservation Details";
}

<h1>Reservation Details</h1>

<dl class="row">
      
    <dt class="col-sm-3">
        Requester
    </dt>

    <dd class="col-sm-9">
        @Model.User?.Name
    </dd>


    <dt class="col-sm-3">
        Vehicle
    </dt>

    <dd class="col-sm-9">
        @Model.Vehicle?.PlateNumber
    </dd>


    <dt class="col-sm-3">
        Start
    </dt>

    <dd class="col-sm-9">
        @Model.StartDateTime
    </dd>


    <dt class="col-sm-3">
        End
    </dt>

    <dd class="col-sm-9">
        @Model.EndDateTime
    </dd>


    <dt class="col-sm-3">
        Origin
    </dt>

    <dd class="col-sm-9">
        @Model.Origin
    </dd>


    <dt class="col-sm-3">
        Destination
    </dt>

    <dd class="col-sm-9">
        @Model.Destination
    </dd>


    <dt class="col-sm-3">
        Passengers
    </dt>

    <dd class="col-sm-9">
        @Model.Passengers
    </dd>


    <dt class="col-sm-3">
        Load
    </dt>

    <dd class="col-sm-9">
        @Model.Load
    </dd>


    <dt class="col-sm-3">
        Purpose
    </dt>

    <dd class="col-sm-9">
        @Model.Purpose
    </dd>


    <dt class="col-sm-3">
        Status
    </dt>

    <dd class="col-sm-9">
        @Model.Status
    </dd>


    <dt class="col-sm-3">
        Driver
    </dt>

    <dd class="col-sm-9">
        @Model.Driver?.Name
    </dd>

</dl>

<a asp-action="Index"
       class="btn btn-secondary">
    Back
</a>