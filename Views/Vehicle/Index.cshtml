```cshtml
@model IEnumerable<BUA_project.Models.Vehicle>

    @{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Vehicles";
    }

    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2>Vehicles</h2>
                <p class="text-muted mb-0">
                    Manage the university fleet vehicles.
                </p>
            </div>

            <a asp-action="Create"
               class="btn btn-primary">
                Add New Vehicle
            </a>

        </div>

        @if (TempData["DeleteError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["DeleteError"]
        </div>
    }

        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered table-striped align-middle">

                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Plate Number</th>
                                <th>Brand</th>
                                <th>Model</th>
                                <th>Type</th>
                                <th>Seats</th>
                                <th>Fuel</th>
                                <th>Status</th>
                                <th>Year</th>
                                <th>Specification</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="11"
                                    class="text-center text-muted">
                                    No vehicles found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var vehicle in Model)
                            {
                            <tr>

                                <!-- Image -->

                                <td>
                                    @if (!string.IsNullOrEmpty(vehicle.ImageUrl))
                                        {
                                    <img src="@vehicle.ImageUrl"
                                         alt="@vehicle.Brand @vehicle.Model"
                                         style="
                                                    width:100px;
                                                    height:70px;
                                                    object-fit:cover;
                                                    border-radius:5px;
                                                 " />
                                        }
                                        else
                                        {
                                    <span class="text-muted">
                                        No Image
                                    </span>
                                        }
                                </td>

                                <!-- Plate Number -->

                                <td>
                                    @vehicle.PlateNumber
                                </td>

                                <!-- Brand -->

                                <td>
                                    @vehicle.Brand
                                </td>

                                <!-- Model -->

                                <td>
                                    @vehicle.Model
                                </td>

                                <!-- Type -->

                                <td>
                                    @vehicle.Type
                                </td>

                                <!-- Seats -->

                                <td>
                                    @vehicle.Seats
                                </td>

                                <!-- Fuel -->

                                <td>
                                    @vehicle.FuelType
                                </td>

                                <!-- Status -->

                                <td>

                                    @if (vehicle.Status == "Available")
                                        {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                        }
                                        else if (vehicle.Status == "Maintenance")
                                        {
                                    <span class="badge bg-warning text-dark">
                                        Maintenance
                                    </span>
                                        }
                                        else if (vehicle.Status == "Unavailable")
                                        {
                                    <span class="badge bg-danger">
                                        Unavailable
                                    </span>
                                        }
                                        else
                                        {
                                    <span class="badge bg-secondary">
                                        @vehicle.Status
                                    </span>
                                        }

                                </td>

                                <!-- Year -->

                                <td>
                                    @vehicle.Year
                                </td>

                                <!-- Specification -->

                                <td>

                                    @if (vehicle.VehicleSpecification != null)
                                        {
                                    <span>
                                        @vehicle.VehicleSpecification.NominalLPer100Km
                                        L/100Km
                                    </span>
                                        }
                                        else
                                        {
                                    <span class="text-muted">
                                        No Specification
                                    </span>
                                        }

                                </td>

                                <!-- Actions -->

                                <td>

                                    <div class="d-flex gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@vehicle.VehicleId"
                                           class="btn btn-info btn-sm">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@vehicle.VehicleId"
                                           class="btn btn-warning btn-sm">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@vehicle.VehicleId"
                                           class="btn btn-danger btn-sm">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                            }
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
    ```
