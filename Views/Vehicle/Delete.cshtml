@model BUA_project.Models.Vehicle

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Vehicle";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Delete Vehicle</h2>
        <p class="text-muted">
            Remove a vehicle from the fleet.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="alert alert-danger">
                <strong>Warning:</strong>
                Are you sure you want to delete this vehicle?
            </div>

            @if (TempData["DeleteError"] != null)
            {
            <div class="alert alert-danger">
                @TempData["DeleteError"]
            </div>
            }

            <dl class="row">

                <dt class="col-sm-3">
                    Plate Number
                </dt>
                <dd class="col-sm-9">
                    @Model.PlateNumber
                </dd>

                <dt class="col-sm-3">
                    Brand
                </dt>
                <dd class="col-sm-9">
                    @Model.Brand
                </dd>

                <dt class="col-sm-3">
                    Model
                </dt>
                <dd class="col-sm-9">
                    @Model.Model
                </dd>

                <dt class="col-sm-3">
                    Type
                </dt>
                <dd class="col-sm-9">
                    @Model.Type
                </dd>

                <dt class="col-sm-3">
                    Seats
                </dt>
                <dd class="col-sm-9">
                    @Model.Seats
                </dd>

                <dt class="col-sm-3">
                    Fuel Type
                </dt>
                <dd class="col-sm-9">
                    @Model.FuelType
                </dd>

                <dt class="col-sm-3">
                    Status
                </dt>
                <dd class="col-sm-9">
                    @Model.Status
                </dd>

                <dt class="col-sm-3">
                    Year
                </dt>
                <dd class="col-sm-9">
                    @Model.Year
                </dd>

            </dl>

            <hr />

            <form asp-action="Delete"
                  method="post">

                <input type="hidden"
                       asp-for="VehicleId" />

                <button type="submit"
                        class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>