
@model BUA_project.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<link rel="stylesheet" href="~/css/vehicle-details.css" />

<div class="vehicle-details-page">

    <!-- Page Header -->
    <div class="vehicle-details-header">

        <div>

            <p class="vehicle-details-subtitle">
                Fleet Management
            </p>

            <h1>
                Vehicle Details
            </h1>

            <p class="vehicle-details-description">
                View vehicle information, specifications, and availability.
            </p>

        </div>


        <!-- Back Button -->

        @if (User.IsInRole("User"))
        {
            <a asp-controller="UserDashboard"
               asp-action="Index"
               class="vehicle-back-btn">

                ← Back to Fleet

            </a>
        }
        else
        {
            <a asp-controller="Vehicle"
               asp-action="Index"
               class="vehicle-back-btn">

                ← Back to Vehicles

            </a>
        }

    </div>


    <!-- Main Vehicle Card -->

    <div class="vehicle-details-main-card">


        <!-- Vehicle Image -->

        <div class="vehicle-details-image-section">

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.Brand @Model.Model"
                     class="vehicle-details-image" />
            }
            else
            {
                <div class="vehicle-details-image-placeholder">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M3 13l1.6-4.8A2 2 0 0 1 6.5 7h11a2 2 0 0 1 1.9 1.2L21 13">
                        </path>

                        <rect x="2.5"
                              y="13"
                              width="19"
                              height="5.5"
                              rx="1.5">
                        </rect>

                        <circle cx="7"
                                cy="18.5"
                                r="1.5">
                        </circle>

                        <circle cx="17"
                                cy="18.5"
                                r="1.5">
                        </circle>

                    </svg>

                    <span>
                        No Vehicle Image
                    </span>

                </div>
            }


            <!-- Status -->

            <div class="vehicle-details-status">

                @if (Model.Status == "Available")
                {
                    <span class="status-badge status-available">
                        Available
                    </span>
                }
                else if (Model.Status == "Maintenance")
                {
                    <span class="status-badge status-maintenance">
                        Maintenance
                    </span>
                }
                else
                {
                    <span class="status-badge status-default">
                        @Model.Status
                    </span>
                }

            </div>

        </div>


        <!-- Vehicle Summary -->

        <div class="vehicle-details-summary">

            <div class="vehicle-details-type">
                @Model.Type · @Model.Year
            </div>

            <h2>
                @Model.Brand @Model.Model
            </h2>

            <p class="vehicle-details-plate">
                Plate Number:
                <strong>
                    @Model.PlateNumber
                </strong>
            </p>


            <!-- Quick Specs -->

            <div class="vehicle-quick-specs">

                <div class="vehicle-quick-spec">

                    <span class="quick-spec-label">
                        Seats
                    </span>

                    <span class="quick-spec-value">
                        @Model.Seats
                    </span>

                </div>


                <div class="vehicle-quick-spec">

                    <span class="quick-spec-label">
                        Fuel
                    </span>

                    <span class="quick-spec-value">
                        @Model.FuelType
                    </span>

                </div>


                <div class="vehicle-quick-spec">

                    <span class="quick-spec-label">
                        Year
                    </span>

                    <span class="quick-spec-value">
                        @Model.Year
                    </span>

                </div>


                <div class="vehicle-quick-spec">

                    <span class="quick-spec-label">
                        Type
                    </span>

                    <span class="quick-spec-value">
                        @Model.Type
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- Vehicle Information -->

    <div class="vehicle-details-section">

        <div class="vehicle-section-header">

            <div>

                <p class="vehicle-section-label">
                    Vehicle
                </p>

                <h2>
                    Vehicle Information
                </h2>

            </div>

        </div>


        <div class="vehicle-info-grid">


            <!-- Plate Number -->

            <div class="vehicle-info-card">

                <span class="vehicle-info-label">
                    Plate Number
                </span>

                <span class="vehicle-info-value">
                    @Model.PlateNumber
                </span>

            </div>


            <!-- Brand -->

            <div class="vehicle-info-card">

                <span class="vehicle-info-label">
                    Brand
                </span>

                <span class="vehicle-info-value">
                    @Model.Brand
                </span>

            </div>


            <!-- Model -->

            <div class="vehicle-info-card">

                <span class="vehicle-info-label">
                    Model
                </span>

                <span class="vehicle-info-value">
                    @Model.Model
                </span>

            </div>


            <!-- Type -->

            <div class="vehicle-info-card">

                <span class="vehicle-info-label">
                    Vehicle Type
                </span>

                <span class="vehicle-info-value">
                    @Model.Type
                </span>

            </div>


            <!-- Seats -->

            <div class="vehicle-info-card">

                <span class="vehicle-info-label">
                    Passenger Capacity
                </span>

                <span class="vehicle-info-value">
                    @Model.Seats Seats
                </span>

            </div>


            <!-- Fuel -->

            <div class="vehicle-info-card">

                <span class="vehicle-info-label">
                    Fuel Type
                </span>

                <span class="vehicle-info-value">
                    @Model.FuelType
                </span>

            </div>


            <!-- Year -->

            <div class="vehicle-info-card">

                <span class="vehicle-info-label">
                    Manufacturing Year
                </span>

                <span class="vehicle-info-value">
                    @Model.Year
                </span>

            </div>


            <!-- Status -->

            <div class="vehicle-info-card">

                <span class="vehicle-info-label">
                    Current Status
                </span>

                <span class="vehicle-info-value">

                    @if (Model.Status == "Available")
                    {
                        <span class="status-badge status-available">
                            Available
                        </span>
                    }
                    else if (Model.Status == "Maintenance")
                    {
                        <span class="status-badge status-maintenance">
                            Maintenance
                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-default">
                            @Model.Status
                        </span>
                    }

                </span>

            </div>

        </div>

    </div>


    <!-- Vehicle Specification -->

    <div class="vehicle-details-section">

        <div class="vehicle-section-header">

            <div>

                <p class="vehicle-section-label">
                    Specifications
                </p>

                <h2>
                    Vehicle Specification
                </h2>

            </div>

        </div>


        @if (Model.VehicleSpecification != null)
        {

            <div class="vehicle-spec-details-grid">


                <!-- Consumption -->

                <div class="vehicle-spec-details-card">

                    <span class="vehicle-spec-details-label">
                        Nominal Consumption
                    </span>

                    <strong>
                        @Model.VehicleSpecification.NominalLPer100Km
                    </strong>

                    <span class="vehicle-spec-unit">
                        L / 100 Km
                    </span>

                </div>


                <!-- Tank -->

                <div class="vehicle-spec-details-card">

                    <span class="vehicle-spec-details-label">
                        Tank Capacity
                    </span>

                    <strong>
                        @Model.VehicleSpecification.TankCapacity
                    </strong>

                    <span class="vehicle-spec-unit">
                        Liters
                    </span>

                </div>


                <!-- Transmission -->

                <div class="vehicle-spec-details-card">

                    <span class="vehicle-spec-details-label">
                        Transmission
                    </span>

                    <strong>
                        @Model.VehicleSpecification.Transmission
                    </strong>

                </div>


                <!-- Accessibility -->

                <div class="vehicle-spec-details-card">

                    <span class="vehicle-spec-details-label">
                        Accessibility
                    </span>

                    <strong>
                        @Model.VehicleSpecification.Accessibility
                    </strong>

                </div>


                <!-- Allowed Load -->

                <div class="vehicle-spec-details-card">

                    <span class="vehicle-spec-details-label">
                        Allowed Load
                    </span>

                    <strong>
                        @Model.VehicleSpecification.AllowedLoad
                    </strong>

                    <span class="vehicle-spec-unit">
                        Kg
                    </span>

                </div>

            </div>

        }
        else
        {

            <div class="vehicle-no-specifications">

                <h3>
                    No Specifications Available
                </h3>

                <p>
                    No vehicle specification has been assigned to this vehicle yet.
                </p>

            </div>

        }

    </div>


<!-- ========================================================= -->
<!-- Availability -->
<!-- ========================================================= -->

<div class="vehicle-details-section">

    <!-- Section Header -->
    <div class="vehicle-section-header">

        <div>

            <p class="vehicle-section-label">
                Availability
            </p>

            <h2>
                Availability Calendar
            </h2>

            <p class="vehicle-section-description">
                View upcoming reservations and scheduled maintenance periods.
            </p>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- Reserved Periods -->
    <!-- ===================================================== -->

    <div class="vehicle-availability-card">

        <div class="vehicle-availability-card-header">

            <div>

                <span class="vehicle-availability-icon reserved-icon">
                    R
                </span>

                <div>

                    <h3>
                        Reserved Periods
                    </h3>

                    <p>
                        Approved reservations for this vehicle
                    </p>

                </div>

            </div>

        </div>


        @if (ViewBag.BusySlots != null &&
             ViewBag.BusySlots.Count > 0)
        {

            <div class="vehicle-availability-list">

                @foreach (var slot in ViewBag.BusySlots)
                {

                    <div class="vehicle-availability-item reserved">

                        <div class="availability-item-status">

                            <span class="availability-dot reserved-dot"></span>

                            <span>
                                Reserved
                            </span>

                        </div>


                        <div class="availability-dates">

                            <div class="availability-date">

                                <span class="availability-date-label">
                                    Start
                                </span>

                                <strong>
                                    @slot.StartDateTime.ToString("MMM dd, yyyy")
                                </strong>

                                <span class="availability-time">
                                    @slot.StartDateTime.ToString("hh:mm tt")
                                </span>

                            </div>


                            <div class="availability-arrow">
                                →
                            </div>


                            <div class="availability-date">

                                <span class="availability-date-label">
                                    End
                                </span>

                                <strong>
                                    @slot.EndDateTime.ToString("MMM dd, yyyy")
                                </strong>

                                <span class="availability-time">
                                    @slot.EndDateTime.ToString("hh:mm tt")
                                </span>

                            </div>

                        </div>

                    </div>

                }

            </div>

        }
        else
        {

            <div class="vehicle-availability-empty">

                <div class="empty-icon">
                    ✓
                </div>

                <div>

                    <strong>
                        No upcoming reservations
                    </strong>

                    <span>
                        This vehicle has no approved reservations in the upcoming period.
                    </span>

                </div>

            </div>

        }

    </div>


    <!-- ===================================================== -->
    <!-- Maintenance -->
    <!-- ===================================================== -->

    <div class="vehicle-availability-card">

        <div class="vehicle-availability-card-header">

            <div>

                <span class="vehicle-availability-icon maintenance-icon">
                    M
                </span>

                <div>

                    <h3>
                        Maintenance
                    </h3>

                    <p>
                        Scheduled maintenance periods
                    </p>

                </div>

            </div>

        </div>


        @if (ViewBag.MaintenanceSlots != null &&
             ViewBag.MaintenanceSlots.Count > 0)
        {

            <div class="vehicle-availability-list">

                @foreach (var maintenance in ViewBag.MaintenanceSlots)
                {

                    <div class="vehicle-availability-item maintenance">

                        <div class="availability-item-status">

                            <span class="availability-dot maintenance-dot"></span>

                            <span>
                                Maintenance
                            </span>

                        </div>


                        <div class="availability-dates">

                            <div class="availability-date">

                                <span class="availability-date-label">
                                    Service Date
                                </span>

                                <strong>
                                    @maintenance.ServiceDate.ToString("MMM dd, yyyy")
                                </strong>

                                <span class="availability-time">
                                    @maintenance.MaintenanceType
                                </span>

                            </div>


                            @if (maintenance.NextServiceDate != null)
                            {

                                <div class="availability-arrow">
                                    →
                                </div>


                                <div class="availability-date">

                                    <span class="availability-date-label">
                                        Next Service
                                    </span>

                                    <strong>
                                        @maintenance.NextServiceDate.Value.ToString("MMM dd, yyyy")
                                    </strong>

                                    <span class="availability-time">
                                        Scheduled maintenance
                                    </span>

                                </div>

                            }

                        </div>

                    </div>

                }

            </div>

        }
        else
        {

            <div class="vehicle-availability-empty">

                <div class="empty-icon">
                    ✓
                </div>

                <div>

                    <strong>
                        No upcoming maintenance
                    </strong>

                    <span>
                        No maintenance periods are currently scheduled.
                    </span>

                </div>

            </div>

        }

    </div>

</div>


<!-- ========================================================= -->
<!-- Actions -->
<!-- ========================================================= -->

<div class="vehicle-details-actions">

    @if (User.IsInRole("Admin"))
    {

        <a asp-controller="Vehicle"
           asp-action="Edit"
           asp-route-id="@Model.VehicleId"
           class="btn btn-primary">

            Edit Vehicle

        </a>


        <a asp-controller="Vehicle"
           asp-action="Index"
           class="btn btn-outline">

            Back to Vehicles

        </a>

    }
    else if (User.IsInRole("User"))
    {

        @if (Model.Status == "Available")
        {

            <a asp-controller="UserReservation"
               asp-action="Create"
               asp-route-vehicleId="@Model.VehicleId"
               class="btn btn-primary">

                Reserve Vehicle

            </a>

        }


        <a asp-controller="UserDashboard"
           asp-action="Index"
           class="btn btn-outline">

            Back to Fleet

        </a>

    }
    else
    {

        <a asp-controller="Vehicle"
           asp-action="Index"
           class="btn btn-outline">

            Back to Vehicles

        </a>

    }

</div>


