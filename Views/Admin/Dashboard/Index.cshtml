@model BUA_project.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Admin Dashboard</h2>
        <p class="text-muted mb-0">
            Overview of the fleet booking system
        </p>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4">

        <!-- Total Vehicles -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-2">
                                Total Vehicles
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.TotalVehicles
                            </h3>
                        </div>

                        <div class="fs-3">
                            🚗
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Available Vehicles -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-2">
                                Available Vehicles
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.AvailableVehicles
                            </h3>
                        </div>

                        <div class="fs-3">
                            ✓
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Reservations -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-2">
                                Total Reservations
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.TotalReservations
                            </h3>
                        </div>

                        <div class="fs-3">
                            📋
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Reservations -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-2">
                                Pending Reservations
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.PendingReservations
                            </h3>
                        </div>

                        <div class="fs-3">
                            ⏳
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Approved Reservations -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-2">
                                Approved Reservations
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.ApprovedReservations
                            </h3>
                        </div>

                        <div class="fs-3">
                            ✓
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Users -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-2">
                                Total Users
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.TotalUsers
                            </h3>
                        </div>

                        <div class="fs-3">
                            👥
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Drivers -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-2">
                                Total Drivers
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.TotalDrivers
                            </h3>
                        </div>

                        <div class="fs-3">
                            👤
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>