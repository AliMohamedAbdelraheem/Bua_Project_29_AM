@model BUA_project.Models.VehicleMaintenance

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Maintenance";
}

<div class="container py-4">

    <div class="mb-4">
        <h2>Delete Maintenance Record</h2>
        <p class="text-muted">
            Review the record before deleting it.
        </p>
    </div>

    <div class="alert alert-danger">
        <strong>Warning!</strong>
        Are you sure you want to delete this maintenance record?
        This action cannot be undone.
    </div>

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-4">
                    Vehicle
                </dt>

                <dd class="col-sm-8">
                    @if (Model.Vehicle != null)
                    {
                    <strong>
                        @Model.Vehicle.Brand @Model.Vehicle.Model
                    </strong>

                    <br />

                    <small class="text-muted">
                        @Model.Vehicle.PlateNumber
                    </small>
                    }
                    else
                    {
                    <span class="text-muted">
                        Unknown Vehicle
                    </span>
                    }
                </dd>


                <dt class="col-sm-4">
                    Maintenance Type
                </dt>

                <dd class="col-sm-8">
                    @Model.MaintenanceType
                </dd>


                <dt class="col-sm-4">
                    Description
                </dt>

                <dd class="col-sm-8">
                    @Model.Description
                </dd>


                <dt class="col-sm-4">
                    Service Date
                </dt>

                <dd class="col-sm-8">
                    @Model.ServiceDate.ToString("dd/MM/yyyy")
                </dd>


                <dt class="col-sm-4">
                    Cost
                </dt>

                <dd class="col-sm-8">
                    @Model.Cost.ToString("N2")
                </dd>


                <dt class="col-sm-4">
                    Status
                </dt>

                <dd class="col-sm-8">
                    @Model.Status
                </dd>

            </dl>

        </div>

    </div>


    <form asp-action="Delete"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="id"
               value="@Model.VehicleMaintenanceId" />

        <button type="submit"
                class="btn btn-danger">
            Confirm Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>