@model IEnumerable<BUA_project.Models.VehicleMaintenance>

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Maintenance";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Vehicle Maintenance</h2>
            <p class="text-muted mb-0">
                Manage vehicle maintenance records
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Maintenance
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No maintenance records found.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Vehicle</th>
                                <th>Maintenance Type</th>
                                <th>Description</th>
                                <th>Service Date</th>
                                <th>Next Service</th>
                                <th>Cost</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @if (item.Vehicle != null)
                                        {
                                            <strong>
                                                @item.Vehicle.Brand
                                                @item.Vehicle.Model
                                            </strong>

                                            <br />

                                            <small class="text-muted">
                                                @item.Vehicle.PlateNumber
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Unknown Vehicle
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @item.MaintenanceType
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            @(item.Description.Length > 50
                                                ? item.Description.Substring(0, 50) + "..."
                                                : item.Description)
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No description
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @item.ServiceDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @if (item.NextServiceDate.HasValue)
                                        {
                                            @item.NextServiceDate.Value.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        @item.Cost.ToString("N2")
                                    </td>

                                    <td>
                                        @if (item.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (item.Status == "In Progress")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                In Progress
                                            </span>
                                        }
                                        else if (item.Status == "Scheduled")
                                        {
                                            <span class="badge bg-primary">
                                                Scheduled
                                            </span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Details"
                                           asp-route-id="@item.VehicleMaintenanceId"
                                           class="btn btn-sm btn-outline-info">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.VehicleMaintenanceId"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.VehicleMaintenanceId"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    }

</div>