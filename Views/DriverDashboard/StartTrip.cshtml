@model BUA_project.Models.Trip

@{
    Layout = "~/Views/DriverNAV/_DriverLayout.cshtml";
    ViewData["Title"] = "Start Trip";
}

<div class="container">

    <div class="mb-4">

        <h1>
            Start Trip #@Model.TripId
        </h1>

        <p class="text-muted">
            Confirm the trip information before starting.
        </p>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">

                    <strong>
                        From
                    </strong>

                    <p>
                        @Model.Reservation.Origin
                    </p>

                </div>


                <div class="col-md-6 mb-3">

                    <strong>
                        To
                    </strong>

                    <p>
                        @Model.Reservation.Destination
                    </p>

                </div>


                <div class="col-md-6 mb-3">

                    <strong>
                        Vehicle
                    </strong>

                    <p>
                        @Model.Reservation.Vehicle.Brand
                        @Model.Reservation.Vehicle.Model
                    </p>

                </div>


                <div class="col-md-6 mb-3">

                    <strong>
                        Plate Number
                    </strong>

                    <p>
                        @Model.Reservation.Vehicle.PlateNumber
                    </p>

                </div>

            </div>


            <hr />


            <form asp-action="StartTrip"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.TripId" />


                <div class="mb-3">

                    <label for="startOdometer"
                           class="form-label">

                        Start Odometer (KM)

                    </label>

                    <input type="number"
                           id="startOdometer"
                           name="startOdometer"
                           class="form-control"
                           min="0"
                           step="0.1"
                           required />

                    <div class="form-text">

                        Enter the current vehicle odometer reading.

                    </div>

                </div>


                <div class="d-flex gap-2">

                    <a asp-action="TripDetails"
                       asp-route-id="@Model.TripId"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-success">

                        Start Trip

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>