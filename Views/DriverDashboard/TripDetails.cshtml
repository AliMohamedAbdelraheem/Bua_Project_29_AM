@model BUA_project.Models.Trip

@{
    Layout = "~/Views/DriverNAV/_DriverLayout.cshtml";
    ViewData["Title"] = "Trip Details";
}

<div class="container">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>

            <h1>
                Trip #@Model.TripId
            </h1>

            <p class="text-muted">
                Trip Details
            </p>

        </div>

        <a asp-action="MyTrips"
           class="btn btn-secondary">

            Back to My Trips

        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <!-- Route -->

                <div class="col-md-6 mb-4">

                    <h5>
                        Route
                    </h5>

                    <p class="mb-1">

                        <strong>
                            From:
                        </strong>

                        @Model.Reservation.Origin

                    </p>

                    <p>

                        <strong>
                            To:
                        </strong>

                        @Model.Reservation.Destination

                    </p>

                </div>


                <!-- Status -->

                <div class="col-md-6 mb-4">

                    <h5>
                        Status
                    </h5>

                    <span class="badge bg-warning text-dark">

                        @Model.Status

                    </span>

                </div>


                <!-- Date -->

                <div class="col-md-6 mb-4">

                    <h5>
                        Schedule
                    </h5>

                    <p class="mb-1">

                        <strong>
                            Start:
                        </strong>

                        @Model.Reservation.StartDateTime.ToString(
                            "dd MMM yyyy - hh:mm tt")

                    </p>

                    <p>

                        <strong>
                            End:
                        </strong>

                        @Model.Reservation.EndDateTime.ToString(
                            "dd MMM yyyy - hh:mm tt")

                    </p>

                </div>


                <!-- Vehicle -->

                <div class="col-md-6 mb-4">

                    <h5>
                        Vehicle
                    </h5>

                    <p class="mb-1">

                        <strong>
                            Brand:
                        </strong>

                        @Model.Reservation.Vehicle.Brand

                    </p>

                    <p class="mb-1">

                        <strong>
                            Model:
                        </strong>

                        @Model.Reservation.Vehicle.Model

                    </p>

                    <p>

                        <strong>
                            Plate:
                        </strong>

                        @Model.Reservation.Vehicle.PlateNumber

                    </p>

                </div>


                <!-- Trip Information -->

                <div class="col-md-6 mb-4">

                    <h5>
                        Trip Information
                    </h5>

                    <p class="mb-1">

                        <strong>
                            Passengers:
                        </strong>

                        @Model.Reservation.Passengers

                    </p>

                    <p class="mb-1">

                        <strong>
                            Load:
                        </strong>

                        @Model.Reservation.Load

                    </p>

                    <p>

                        <strong>
                            Purpose:
                        </strong>

                        @Model.Reservation.Purpose

                    </p>

                </div>

            </div>


            <hr />


            <div class="mt-3">

                <a asp-controller="DriverDashboard"
                   asp-action="StartTrip"
                   asp-route-id="@Model.TripId"
                   class="btn btn-success">

                    Start Trip

                </a>

            </div>

        </div>

    </div>

</div>