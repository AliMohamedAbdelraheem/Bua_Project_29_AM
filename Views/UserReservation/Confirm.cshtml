@model BUA_project.Models.ViewModels.UserReservationConfirmationViewModel

@{
    Layout = "~/Views/UserNAV/_UserLayout.cshtml";
    ViewData["Title"] = "Confirm Your Reservation";
}

<link rel="stylesheet" href="~/css/reservation-confirmation.css" />

<div class="reservation-confirmation-page">

    <!-- Page Header -->
    <div class="reservation-page-header">

        <div>
            <p class="reservation-eyebrow">
                Reservation Review
            </p>

            <h1>
                Confirm Your Reservation
            </h1>

            <p class="reservation-subtitle">
                Review your trip information before submitting the reservation.
            </p>
        </div>

    </div>


    <!-- Main Card -->
    <div class="reservation-confirmation-card">

        <!-- ============================================ -->
        <!-- Vehicle Information -->
        <!-- ============================================ -->

        <section class="confirmation-section">

            <div class="confirmation-section-header">

                <div>
                    <span class="section-number">01</span>

                    <div>
                        <p class="section-label">
                            Vehicle
                        </p>

                        <h2>
                            Vehicle Information
                        </h2>
                    </div>
                </div>

            </div>


            <div class="info-grid">

                <div class="info-item">
                    <span class="info-label">
                        Vehicle
                    </span>

                    <span class="info-value">
                        @Model.Vehicle.Brand @Model.Vehicle.Model
                    </span>
                </div>


                <div class="info-item">
                    <span class="info-label">
                        Type
                    </span>

                    <span class="info-value">
                        @Model.Vehicle.Type
                    </span>
                </div>


                <div class="info-item">
                    <span class="info-label">
                        Plate Number
                    </span>

                    <span class="info-value">
                        @Model.Vehicle.PlateNumber
                    </span>
                </div>


                <div class="info-item">
                    <span class="info-label">
                        Seats
                    </span>

                    <span class="info-value">
                        @Model.Vehicle.Seats
                    </span>
                </div>

            </div>

        </section>


        <!-- ============================================ -->
        <!-- Reservation Information -->
        <!-- ============================================ -->

        <section class="confirmation-section">

            <div class="confirmation-section-header">

                <div>
                    <span class="section-number">02</span>

                    <div>
                        <p class="section-label">
                            Reservation
                        </p>

                        <h2>
                            Reservation Details
                        </h2>
                    </div>
                </div>

            </div>


            <div class="info-grid">

                <div class="info-item">
                    <span class="info-label">
                        From
                    </span>

                    <span class="info-value">
                        @Model.Origin
                    </span>
                </div>


                <div class="info-item">
                    <span class="info-label">
                        To
                    </span>

                    <span class="info-value">
                        @Model.Destination
                    </span>
                </div>


                <div class="info-item">
                    <span class="info-label">
                        Passengers
                    </span>

                    <span class="info-value">
                        @Model.Passengers
                    </span>
                </div>


                <div class="info-item">
                    <span class="info-label">
                        Load
                    </span>

                    <span class="info-value">
                        @Model.Load
                    </span>
                </div>


                <div class="info-item info-item-wide">
                    <span class="info-label">
                        Purpose
                    </span>

                    <span class="info-value">
                        @Model.Purpose
                    </span>
                </div>

            </div>


            <!-- Date / Time -->

            <div class="datetime-grid">

                <div class="datetime-card">

                    <span class="info-label">
                        Start
                    </span>

                    <strong>
                        @Model.StartDateTime.ToString("MMM dd, yyyy")
                    </strong>

                    <span>
                        @Model.StartDateTime.ToString("HH:mm")
                    </span>

                </div>


                <div class="datetime-card">

                    <span class="info-label">
                        End
                    </span>

                    <strong>
                        @Model.EndDateTime.ToString("MMM dd, yyyy")
                    </strong>

                    <span>
                        @Model.EndDateTime.ToString("HH:mm")
                    </span>

                </div>


                <div class="datetime-card">

                    <span class="info-label">
                        Duration
                    </span>

                    <strong>
                        @((Model.EndDateTime - Model.StartDateTime).TotalHours.ToString("0.##"))
                    </strong>

                    <span>
                        hours
                    </span>

                </div>

            </div>

        </section>


        <!-- ============================================ -->
        <!-- Route Estimate -->
        <!-- ============================================ -->

        <section class="confirmation-section">

            <div class="confirmation-section-header">

                <div>
                    <span class="section-number">03</span>

                    <div>
                        <p class="section-label">
                            Route
                        </p>

                        <h2>
                            Route Estimate
                        </h2>
                    </div>
                </div>

            </div>


            <div class="stats-grid">

                <div class="stat-card">

                    <span class="stat-label">
                        Distance
                    </span>

                    <strong>
                        @Model.Distance.ToString("0.##")
                    </strong>

                    <span class="stat-unit">
                        km
                    </span>

                </div>


                <div class="stat-card">

                    <span class="stat-label">
                        Duration
                    </span>

                    <strong>
                        @Model.Duration.TotalHours.ToString("0.##")
                    </strong>

                    <span class="stat-unit">
                        hours
                    </span>

                </div>


                <div class="stat-card">

                    <span class="stat-label">
                        Provider
                    </span>

                    <strong class="stat-text">
                        @Model.RouteProvider
                    </strong>

                </div>

            </div>

        </section>


        <!-- ============================================ -->
        <!-- Fuel Prediction -->
        <!-- ============================================ -->

        <section class="confirmation-section">

            <div class="confirmation-section-header">

                <div>
                    <span class="section-number">04</span>

                    <div>
                        <p class="section-label">
                            Fuel
                        </p>

                        <h2>
                            Fuel Prediction
                        </h2>
                    </div>
                </div>

            </div>


            <div class="stats-grid fuel-grid">

                <div class="stat-card">

                    <span class="stat-label">
                        Estimated Fuel
                    </span>

                    <strong>
                        @Model.EstimatedFuel.ToString("0.##")
                    </strong>

                    <span class="stat-unit">
                        L
                    </span>

                </div>


                <div class="stat-card">

                    <span class="stat-label">
                        Fuel Range
                    </span>

                    <strong class="stat-text">
                        @Model.FuelMin.ToString("0.##")
                        -
                        @Model.FuelMax.ToString("0.##")
                        L
                    </strong>

                </div>


                <div class="stat-card">

                    <span class="stat-label">
                        Estimated Cost
                    </span>

                    <strong>
                        @Model.FuelCost.ToString("0.##")
                    </strong>

                    <span class="stat-unit">
                        EGP
                    </span>

                </div>


                <div class="stat-card">

                    <span class="stat-label">
                        Cost Range
                    </span>

                    <strong class="stat-text">
                        @Model.FuelCostMin.ToString("0.##")
                        -
                        @Model.FuelCostMax.ToString("0.##")
                        EGP
                    </strong>

                </div>


                <div class="stat-card">

                    <span class="stat-label">
                        Fuel Price
                    </span>

                    <strong>
                        @Model.FuelPricePerLiter.ToString("0.##")
                    </strong>

                    <span class="stat-unit">
                        EGP / Liter
                    </span>

                </div>


                <div class="stat-card">

                    <span class="stat-label">
                        Method
                    </span>

                    <strong class="stat-text">
                        @Model.FuelMethod
                    </strong>

                </div>

            </div>


            <!-- Assumptions -->

            <div class="assumptions-box">

                <div class="assumptions-title">
                    Fuel Assumptions
                </div>

                <p>
                    @Model.FuelAssumptions
                </p>

            </div>

        </section>


        <!-- ============================================ -->
        <!-- Confirmation Message -->
        <!-- ============================================ -->

        <div class="confirmation-warning">

            <div class="warning-content">

                <strong>
                    Please review your reservation.
                </strong>

                <p>
                    Once you confirm, the reservation will be submitted
                    with <strong>Pending</strong> status for approval.
                </p>

            </div>

        </div>


        <!-- ============================================ -->
        <!-- Actions -->
        <!-- ============================================ -->

        <div class="confirmation-actions">

            <!-- Cancel -->

            <a asp-controller="UserReservation"
               asp-action="Cancel"
               class="confirmation-btn confirmation-btn-secondary">

                Cancel

            </a>


            <!-- Confirm -->

            <form asp-controller="UserReservation"
                  asp-action="ConfirmReservation"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="confirmation-btn confirmation-btn-primary">

                    Confirm Reservation

                </button>

            </form>

        </div>

    </div>

</div>

