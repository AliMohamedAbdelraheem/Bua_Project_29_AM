@model BUA_project.Models.ViewModels.UserReservationViewModel

@{
    Layout = "~/Views/UserNAV/_UserLayout.cshtml";
    ViewData["Title"] = "Create Reservation";
}

<link rel="stylesheet" href="~/css/user_reservation.css" />

<section class="app-shell__content app-shell__content--padded">

    <div class="reservation-page">

        <!-- ===================================================== -->
        <!-- PAGE HEADER -->
        <!-- ===================================================== -->

        <div class="reservation-page-header">

            <p class="page-subtitle">
                Fleet Reservation
            </p>

            <h1>Create Reservation</h1>

            <p>
                Enter your trip information to submit a vehicle reservation.
            </p>

            <div asp-validation-summary="All"
                 class="reservation-validation">
            </div>

        </div>


        <!-- ===================================================== -->
        <!-- FORM CARD -->
        <!-- ===================================================== -->

        <div class="reservation-form-card">

            <div class="reservation-card-header">

                <h2>Reservation Details</h2>

                <p>
                    Provide the required information for your trip.
                </p>

            </div>


            <div class="reservation-form-body">

                <form asp-controller="UserReservation"
                      asp-action="Create"
                      method="post"
                      id="reservationForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="VehicleId" />


                    <!-- ================================================= -->
                    <!-- TRIP INFORMATION -->
                    <!-- ================================================= -->

                    <div class="reservation-section">

                        <div class="reservation-section-title">

                            <h3>Trip Information</h3>

                            <p>
                                Select the trip dates and route.
                            </p>

                        </div>


                        <!-- ================================================= -->
                        <!-- VEHICLE AVAILABILITY CALENDAR -->
                        <!-- ================================================= -->

                        <div class="vehicle-calendar-wrapper">

                            <div class="calendar-header">

                                <button type="button"
                                        id="previousMonth"
                                        class="calendar-nav-button">
                                    ‹
                                </button>

                                <h3 id="calendarMonth">
                                    Loading...
                                </h3>

                                <button type="button"
                                        id="nextMonth"
                                        class="calendar-nav-button">
                                    ›
                                </button>

                            </div>


                            <!-- Legend -->

                            <div class="calendar-legend">

                                <div class="legend-item">
                                    <span class="legend-color available"></span>
                                    Available
                                </div>

                                <div class="legend-item">
                                    <span class="legend-color pending"></span>
                                    Pending
                                </div>

                                <div class="legend-item">
                                    <span class="legend-color approved"></span>
                                    Booked
                                </div>

                            </div>


                            <!-- Calendar -->

                            <div class="calendar-weekdays">

                                <div>Sun</div>
                                <div>Mon</div>
                                <div>Tue</div>
                                <div>Wed</div>
                                <div>Thu</div>
                                <div>Fri</div>
                                <div>Sat</div>

                            </div>


                            <div id="calendarDays"
                                 class="calendar-days">
                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- SELECTED DATE -->
                        <!-- ================================================= -->

                        <div id="selectedDateInfo"
                             class="selected-date-info"
                             style="display:none;">

                            <strong>
                                Selected Date:
                            </strong>

                            <span id="selectedDateText"></span>

                        </div>


                        <!-- ================================================= -->
                        <!-- START / END -->
                        <!-- ================================================= -->

                        <div class="reservation-form-grid">

                            <!-- Start -->

                            <div class="reservation-form-group">

                                <label asp-for="StartDateTime">
                                    Start Date & Time
                                </label>

                                <input asp-for="StartDateTime"
                                       type="datetime-local"
                                       class="form-control"
                                       id="startDateTime" />

                                <span asp-validation-for="StartDateTime"
                                      class="field-validation-error">
                                </span>

                            </div>


                            <!-- End -->

                            <div class="reservation-form-group">

                                <label asp-for="EndDateTime">
                                    End Date & Time
                                </label>

                                <input asp-for="EndDateTime"
                                       type="datetime-local"
                                       class="form-control"
                                       id="endDateTime" />

                                <span asp-validation-for="EndDateTime"
                                      class="field-validation-error">
                                </span>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- ORIGIN -->
                        <!-- ================================================= -->

                        <div class="reservation-form-grid">

                            <div class="reservation-form-group">

                                <label asp-for="Origin">
                                    Origin
                                </label>

                                <select asp-for="Origin"
                                        id="origin"
                                        class="form-select">

                                    <option value="">
                                        Select Origin
                                    </option>

                                    @if (ViewBag.Origins != null)
                                    {
                                        foreach (var origin in ViewBag.Origins)
                                        {
                                            <option value="@origin">
                                                @origin
                                            </option>
                                        }
                                    }

                                </select>

                                <span asp-validation-for="Origin"
                                      class="field-validation-error">
                                </span>

                            </div>


                            <!-- Destination -->

                            <div class="reservation-form-group">

                                <label asp-for="Destination">
                                    Destination
                                </label>

                                <select asp-for="Destination"
                                        id="destination"
                                        class="form-select">

                                    <option value="">
                                        Select Destination
                                    </option>

                                    @if (ViewBag.Routes != null)
                                    {
                                        foreach (var route in ViewBag.Routes)
                                        {
                                            <option value="@route.Destination"
                                                    data-origin="@route.Origin">

                                                @route.Destination

                                            </option>
                                        }
                                    }

                                </select>

                                <span asp-validation-for="Destination"
                                      class="field-validation-error">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- ===================================================== -->
                    <!-- PASSENGERS & LOAD -->
                    <!-- ===================================================== -->

                    <div class="reservation-section">

                        <div class="reservation-section-title">

                            <h3>Passengers & Load</h3>

                            <p>
                                Specify the number of passengers and required load.
                            </p>

                        </div>


                        <div class="reservation-form-grid">

                            <!-- Passengers -->

                            <div class="reservation-form-group">

                                <label asp-for="Passengers">
                                    Passengers
                                </label>

                                <input asp-for="Passengers"
                                       type="number"
                                       min="1"
                                       max="@(ViewBag.Vehicle?.Seats ?? 1)"
                                       step="1"
                                       class="form-control" />

                                <span asp-validation-for="Passengers"
                                      class="field-validation-error">
                                </span>

                                @if (ViewBag.Vehicle != null)
                                {
                                    <span class="reservation-help">
                                        Maximum passengers:
                                        @ViewBag.Vehicle.Seats
                                    </span>
                                }

                            </div>


                            <!-- Load -->

                            <div class="reservation-form-group">

                                <label asp-for="Load">
                                    Load
                                </label>

                                <input asp-for="Load"
                                       type="number"
                                       min="0"
                                       max="@(ViewBag.Vehicle?.VehicleSpecification?.AllowedLoad ?? 0)"
                                       step="0.01"
                                       class="form-control" />

                                <span asp-validation-for="Load"
                                      class="field-validation-error">
                                </span>

                                @if (ViewBag.Vehicle?.VehicleSpecification != null)
                                {
                                    <span class="reservation-help">
                                        Maximum allowed load:
                                        @ViewBag.Vehicle.VehicleSpecification.AllowedLoad
                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    <!-- ===================================================== -->
                    <!-- PURPOSE -->
                    <!-- ===================================================== -->

                    <div class="reservation-section">

                        <div class="reservation-section-title">

                            <h3>Trip Purpose</h3>

                            <p>
                                Explain the purpose of your reservation.
                            </p>

                        </div>


                        <div class="reservation-form-group full-width">

                            <label asp-for="Purpose">
                                Purpose
                            </label>

                            <textarea asp-for="Purpose"
                                      class="form-control"
                                      placeholder="Enter the purpose of your trip..."></textarea>

                            <span asp-validation-for="Purpose"
                                  class="field-validation-error">
                            </span>

                        </div>

                    </div>


                    <!-- ===================================================== -->
                    <!-- ACTIONS -->
                    <!-- ===================================================== -->

                    <div class="reservation-actions">

                        <a asp-controller="UserDashboard"
                           asp-action="Index"
                           class="btn btn-secondary">

                            Back

                        </a>


                        <button type="submit"
                                class="btn btn-primary">

                            Continue

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</section>


<!-- ============================================================= -->
<!-- TIME POPUP -->
<!-- ============================================================= -->

<div id="timeModal"
     class="time-modal"
     style="display:none;">

    <div class="time-modal-overlay"></div>

    <div class="time-modal-content">

        <div class="time-modal-header">

            <div>

                <p class="time-modal-label">
                    Vehicle Availability
                </p>

                <h2 id="modalDate">
                    Selected Date
                </h2>

            </div>

            <button type="button"
                    id="closeTimeModal"
                    class="time-modal-close">
                ×
            </button>

        </div>


        <!-- Legend -->

        <div class="time-legend">

            <div class="legend-item">
                <span class="legend-color available"></span>
                Available
            </div>

            <div class="legend-item">
                <span class="legend-color pending"></span>
                Pending
            </div>

            <div class="legend-item">
                <span class="legend-color approved"></span>
                Booked
            </div>

        </div>


        <div id="timeSlots"
             class="time-slots">
        </div>


        <div class="time-modal-footer">

            <button type="button"
                    id="cancelTimeSelection"
                    class="btn btn-secondary">

                Close

            </button>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        /* =========================================================
           VARIABLES
        ========================================================= */

        const vehicleId =
            document.querySelector(
                'input[name="VehicleId"]'
            ).value;


        const calendarDays =
            document.getElementById(
                "calendarDays"
            );


        const calendarMonth =
            document.getElementById(
                "calendarMonth"
            );


        const previousMonth =
            document.getElementById(
                "previousMonth"
            );


        const nextMonth =
            document.getElementById(
                "nextMonth"
            );


        const timeModal =
            document.getElementById(
                "timeModal"
            );


        const timeSlots =
            document.getElementById(
                "timeSlots"
            );


        const modalDate =
            document.getElementById(
                "modalDate"
            );


        const closeTimeModal =
            document.getElementById(
                "closeTimeModal"
            );


        const cancelTimeSelection =
            document.getElementById(
                "cancelTimeSelection"
            );


        const startInput =
            document.getElementById(
                "startDateTime"
            );


        const endInput =
            document.getElementById(
                "endDateTime"
            );


        let currentCalendarDate =
            new Date();


        let availabilityData = [];


        let selectedDate = null;


        /* =========================================================
           LOAD AVAILABILITY
        ========================================================= */

        async function loadAvailability() {

            try {

                const response =
                    await fetch(
                        `/UserReservation/GetVehicleAvailability?vehicleId=${vehicleId}`
                    );


                if (!response.ok) {

                    throw new Error(
                        "Failed to load availability."
                    );

                }


                availabilityData =
                    await response.json();


                renderCalendar();

            }
            catch (error) {

                console.error(error);

                calendarDays.innerHTML = `
                    <div class="calendar-error">
                        Unable to load vehicle availability.
                    </div>
                `;

            }

        }


        /* =========================================================
           FORMAT DATE KEY
        ========================================================= */

        function getDateKey(date) {

            const year =
                date.getFullYear();

            const month =
                String(
                    date.getMonth() + 1
                ).padStart(2, "0");

            const day =
                String(
                    date.getDate()
                ).padStart(2, "0");

            return `${year}-${month}-${day}`;

        }


        /* =========================================================
           FIND DAY DATA
        ========================================================= */

        function getDayData(date) {

            const key =
                getDateKey(date);

            return availabilityData.find(
                x => x.date === key
            );

        }


        /* =========================================================
           RENDER CALENDAR
        ========================================================= */

        function renderCalendar() {

            calendarDays.innerHTML = "";


            const year =
                currentCalendarDate.getFullYear();


            const month =
                currentCalendarDate.getMonth();


            const monthName =
                currentCalendarDate.toLocaleString(
                    "default",
                    {
                        month: "long",
                        year: "numeric"
                    }
                );


            calendarMonth.textContent =
                monthName;


            const firstDay =
                new Date(
                    year,
                    month,
                    1
                ).getDay();


            const daysInMonth =
                new Date(
                    year,
                    month + 1,
                    0
                ).getDate();


            /* Empty cells */

            for (
                let i = 0;
                i < firstDay;
                i++
            ) {

                const empty =
                    document.createElement(
                        "div"
                    );

                empty.className =
                    "calendar-day empty";

                calendarDays.appendChild(
                    empty
                );

            }


            /* Days */

            for (
                let day = 1;
                day <= daysInMonth;
                day++
            ) {

                const date =
                    new Date(
                        year,
                        month,
                        day
                    );


                const dayElement =
                    document.createElement(
                        "button"
                    );


                dayElement.type =
                    "button";


                dayElement.className =
                    "calendar-day";


                const dayData =
                    getDayData(date);


                /*
                    Default = Available
                */

                let status =
                    "available";


                if (dayData) {

                    status =
                        dayData.status;

                }


                dayElement.classList.add(
                    status
                );


                dayElement.innerHTML = `

                    <span class="calendar-day-number">
                        ${day}
                    </span>

                    <span class="calendar-day-status">
                        ${getStatusText(status)}
                    </span>

                `;


                /*
                    If fully booked,
                    disable click
                */

                if (
                    status ===
                    "approved"
                ) {

                    /*
                       Still allow opening the day
                       so user can see hours.
                    */

                    dayElement.disabled =
                        false;

                }


                dayElement.addEventListener(
                    "click",
                    function () {

                        openTimeModal(date);

                    }
                );


                calendarDays.appendChild(
                    dayElement
                );

            }

        }


        /* =========================================================
           STATUS TEXT
        ========================================================= */

        function getStatusText(status) {

            if (
                status ===
                "approved"
            ) {

                return "Booked";

            }


            if (
                status ===
                "pending"
            ) {

                return "Pending";

            }


            return "Available";

        }


        /* =========================================================
           OPEN TIME MODAL
        ========================================================= */

        function openTimeModal(date) {

            selectedDate =
                date;


            modalDate.textContent =
                date.toLocaleDateString(
                    "en-US",
                    {
                        weekday: "long",
                        year: "numeric",
                        month: "long",
                        day: "numeric"
                    }
                );


            timeSlots.innerHTML = "";


            const dayData =
                getDayData(date);


            /*
               Create slots every 30 minutes
            */

            for (
                let hour = 0;
                hour < 24;
                hour++
            ) {

                for (
                    let minute = 0;
                    minute < 60;
                    minute += 30
                ) {

                    const slot =
                        document.createElement(
                            "button"
                        );


                    slot.type =
                        "button";


                    slot.className =
                        "time-slot";


                    const hourText =
                        String(hour)
                            .padStart(2, "0");


                    const minuteText =
                        String(minute)
                            .padStart(2, "0");


                    const time =
                        `${hourText}:${minuteText}`;


                    slot.textContent =
                        time;


                    let slotStatus =
                        getTimeSlotStatus(
                            date,
                            hour,
                            minute,
                            dayData
                        );


                    slot.classList.add(
                        slotStatus
                    );


                    if (
                        slotStatus ===
                        "available"
                    ) {

                        slot.addEventListener(
                            "click",
                            function () {

                                selectTime(
                                    date,
                                    hour,
                                    minute
                                );

                            }
                        );

                    }


                    timeSlots.appendChild(
                        slot
                    );

                }

            }


            timeModal.style.display =
                "flex";

            document.body.classList.add(
                "modal-open"
            );

        }


        /* =========================================================
           GET TIME SLOT STATUS
        ========================================================= */

        function getTimeSlotStatus(
            date,
            hour,
            minute,
            dayData
        ) {

            if (!dayData)
                return "available";


            const slotDate =
                new Date(
                    date.getFullYear(),
                    date.getMonth(),
                    date.getDate(),
                    hour,
                    minute
                );


            const reservations =
                dayData.reservations || [];


            for (
                const reservation
                of reservations
            ) {

                const start =
                    new Date(
                        reservation.start
                    );


                const end =
                    new Date(
                        reservation.end
                    );


                if (
                    slotDate >= start &&
                    slotDate < end
                ) {

                    if (
                        reservation.status
                            .toLowerCase()
                        ===
                        "approved"
                    ) {

                        return "approved";

                    }


                    if (
                        reservation.status
                            .toLowerCase()
                        ===
                        "pending"
                    ) {

                        return "pending";

                    }

                }

            }


            return "available";

        }


        /* =========================================================
           SELECT TIME
        ========================================================= */

        function selectTime(
            date,
            hour,
            minute
        ) {

            const selected =
                new Date(
                    date.getFullYear(),
                    date.getMonth(),
                    date.getDate(),
                    hour,
                    minute
                );


            /*
                If Start is empty,
                choose Start.
            */

            if (
                !startInput.value ||
                (
                    startInput.value &&
                    endInput.value
                )
            ) {

                startInput.value =
                    formatDateTimeLocal(
                        selected
                    );

                endInput.value =
                    "";


                closeModal();

                return;

            }


            /*
                Otherwise choose End.
            */

            const start =
                new Date(
                    startInput.value
                );


            if (
                selected <= start
            ) {

                alert(
                    "End time must be after the start time."
                );

                return;

            }


            /*
                Check overlapping
                reservations.
            */

            if (
                hasReservationBetween(
                    start,
                    selected
                )
            ) {

                alert(
                    "The selected period contains a reserved or pending time."
                );

                return;

            }


            endInput.value =
                formatDateTimeLocal(
                    selected
                );


            closeModal();

        }


        /* =========================================================
           CHECK OVERLAPPING RESERVATION
        ========================================================= */

        function hasReservationBetween(
            start,
            end
        ) {

            for (
                const day
                of availabilityData
            ) {

                for (
                    const reservation
                    of (
                        day.reservations ||
                        []
                    )
                ) {

                    const reservationStart =
                        new Date(
                            reservation.start
                        );


                    const reservationEnd =
                        new Date(
                            reservation.end
                        );


                    if (
                        start <
                        reservationEnd
                        &&
                        end >
                        reservationStart
                    ) {

                        return true;

                    }

                }

            }


            return false;

        }


        /* =========================================================
           FORMAT DATETIME-LOCAL
        ========================================================= */

        function formatDateTimeLocal(
            date
        ) {

            const year =
                date.getFullYear();


            const month =
                String(
                    date.getMonth() + 1
                ).padStart(2, "0");


            const day =
                String(
                    date.getDate()
                ).padStart(2, "0");


            const hour =
                String(
                    date.getHours()
                ).padStart(2, "0");


            const minute =
                String(
                    date.getMinutes()
                ).padStart(2, "0");


            return `${year}-${month}-${day}T${hour}:${minute}`;

        }


        /* =========================================================
           CLOSE MODAL
        ========================================================= */

        function closeModal() {

            timeModal.style.display =
                "none";


            document.body.classList.remove(
                "modal-open"
            );

        }


        closeTimeModal.addEventListener(
            "click",
            closeModal
        );


        cancelTimeSelection.addEventListener(
            "click",
            closeModal
        );


        document
            .querySelector(
                ".time-modal-overlay"
            )
            .addEventListener(
                "click",
                closeModal
            );


        /* =========================================================
           MONTH NAVIGATION
        ========================================================= */

        previousMonth.addEventListener(
            "click",
            function () {

                currentCalendarDate.setMonth(
                    currentCalendarDate.getMonth() - 1
                );

                renderCalendar();

            }
        );


        nextMonth.addEventListener(
            "click",
            function () {

                currentCalendarDate.setMonth(
                    currentCalendarDate.getMonth() + 1
                );

                renderCalendar();

            }
        );


        /* =========================================================
           ORIGIN / DESTINATION
        ========================================================= */

        const originSelect =
            document.getElementById(
                "origin"
            );


        const destinationSelect =
            document.getElementById(
                "destination"
            );


        const allDestinationOptions =
            Array.from(
                destinationSelect.options
            );


        originSelect.addEventListener(
            "change",
            function () {

                const selectedOrigin =
                    this.value;


                destinationSelect.innerHTML =
                    "";


                const defaultOption =
                    document.createElement(
                        "option"
                    );


                defaultOption.value =
                    "";


                defaultOption.textContent =
                    "Select Destination";


                destinationSelect.appendChild(
                    defaultOption
                );


                allDestinationOptions.forEach(
                    function (option) {

                        if (
                            !option.dataset.origin
                        )
                            return;


                        if (
                            option.dataset.origin ===
                            selectedOrigin
                        ) {

                            destinationSelect.appendChild(
                                option.cloneNode(true)
                            );

                        }

                    }
                );

            }
        );


        /* =========================================================
           LOAD CALENDAR
        ========================================================= */

        loadAvailability();

    </script>
}