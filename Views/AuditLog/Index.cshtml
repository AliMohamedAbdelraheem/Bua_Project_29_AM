@model IEnumerable<BUA_project.Models.AuditLog>

    @{
    ViewData["Title"] = "Audit Logs";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";

    var actions = ViewBag.Actions as List<string> ?? new List<string>();
    var entities = ViewBag.Entities as List<string> ?? new List<string>();
    }

    <div class="container-fluid py-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Audit Logs</h2>
                <p class="text-muted mb-0">
                    Review important system actions and workflow events.
                </p>
            </div>

            <div>
                <span class="badge bg-secondary px-3 py-2">
                    Read Only
                </span>
            </div>
        </div>

        <!-- Filters -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">

                <form asp-action="Index" method="get">

                    <div class="row g-3 align-items-end">

                        <!-- Search -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">
                                Search
                            </label>

                            <input type="text"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="form-control"
                                   placeholder="User name or Entity ID" />
                        </div>

                        <!-- Action -->
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                Action
                            </label>

                            <select name="action" class="form-select">

                                <option value="">
                                    All Actions
                                </option>

                                @foreach (var item in actions)
                            {
                                <option value="@item"
                                        selected="@(ViewBag.SelectedAction == item)">
                                    @item
                                </option>
                            }

                            </select>
                        </div>

                        <!-- Entity -->
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                Entity
                            </label>

                            <select name="entityName" class="form-select">

                                <option value="">
                                    All Entities
                                </option>

                                @foreach (var item in entities)
                            {
                                <option value="@item"
                                        selected="@(ViewBag.SelectedEntity == item)">
                                    @item
                                </option>
                            }

                            </select>
                        </div>

                        <!-- Buttons -->
                        <div class="col-md-2 d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">
                                Filter
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Clear
                            </a>

                        </div>

                    </div>

                </form>

            </div>
        </div>


        <!-- Audit Logs Table -->
        <div class="card shadow-sm border-0">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Timestamp</th>
                                <th>User</th>
                                <th>Role</th>
                                <th>Action</th>
                                <th>Entity</th>
                                <th>Entity ID</th>
                                <th>Reason</th>
                                <th></th>
                            </tr>

                        </thead>

                        <tbody>

                            @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center py-5 text-muted">

                                    No audit logs found.

                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var log in Model)
                            {
                            <tr>

                                <td>
                                    <div class="fw-semibold">
                                        @log.Timestamp.ToString("dd MMM yyyy")
                                    </div>

                                    <small class="text-muted">
                                        @log.Timestamp.ToString("hh:mm tt")
                                    </small>
                                </td>

                                <td>
                                    @if (log.User != null)
                                        {
                                    <span class="fw-semibold">
                                        @log.User.Name
                                    </span>

                                    <br />

                                    <small class="text-muted">
                                        @log.User.Email
                                    </small>
                                        }
                                        else
                                        {
                                    <span class="text-muted">
                                        System / Unknown
                                    </span>
                                        }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(log.UserRole))
                                        {
                                    <span class="badge bg-secondary">
                                        @log.UserRole
                                    </span>
                                        }
                                        else
                                        {
                                    <span class="text-muted">
                                        —
                                    </span>
                                        }
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        @log.Action
                                    </span>
                                </td>

                                <td>
                                    <span class="fw-semibold">
                                        @log.EntityName
                                    </span>
                                </td>

                                <td>
                                    #@log.EntityId
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(log.Reason))
                                        {
                                    <span>
                                        @log.Reason
                                    </span>
                                        }
                                        else
                                        {
                                    <span class="text-muted">
                                        —
                                    </span>
                                        }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@log.AuditLogId"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>

                                </td>

                            </tr>
                            }
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>