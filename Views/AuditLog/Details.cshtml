@model BUA_project.Models.AuditLog

@{
    ViewData["Title"] = "Audit Log Details";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Audit Log Details</h2>
            <p class="text-muted mb-0">
                Detailed information about this recorded event.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Audit Logs
        </a>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="text-muted small">
                        Action
                    </label>

                    <div class="fw-semibold fs-5">
                        @Model.Action
                    </div>
                </div>


                <div class="col-md-6">
                    <label class="text-muted small">
                        Timestamp
                    </label>

                    <div class="fw-semibold">
                        @Model.Timestamp.ToString("dd MMM yyyy, hh:mm:ss tt")
                    </div>
                </div>


                <div class="col-md-6">
                    <label class="text-muted small">
                        Entity
                    </label>

                    <div class="fw-semibold">
                        @Model.EntityName
                    </div>
                </div>


                <div class="col-md-6">
                    <label class="text-muted small">
                        Entity ID
                    </label>

                    <div class="fw-semibold">
                        #@Model.EntityId
                    </div>
                </div>


                <div class="col-md-6">
                    <label class="text-muted small">
                        User
                    </label>

                    <div class="fw-semibold">

                        @if (Model.User != null)
                        {
                        @Model.User.Name
                        }
                        else
                        {
                        <span class="text-muted">
                            System / Unknown
                        </span>
                        }

                    </div>
                </div>


                <div class="col-md-6">
                    <label class="text-muted small">
                        Role
                    </label>

                    <div>
                        @if (!string.IsNullOrWhiteSpace(Model.UserRole))
                        {
                        <span class="badge bg-secondary">
                            @Model.UserRole
                        </span>
                        }
                        else
                        {
                        <span class="text-muted">
                            —
                        </span>
                        }
                    </div>
                </div>


                <div class="col-12">
                    <label class="text-muted small">
                        Reason
                    </label>

                    <div class="border rounded p-3 bg-light">

                        @if (!string.IsNullOrWhiteSpace(Model.Reason))
                        {
                        @Model.Reason
                        }
                        else
                        {
                        <span class="text-muted">
                            No reason provided.
                        </span>
                        }

                    </div>
                </div>


                <div class="col-12">
                    <label class="text-muted small">
                        Additional Details
                    </label>

                    <div class="border rounded p-3 bg-light">

                        @if (!string.IsNullOrWhiteSpace(Model.Details))
                        {
                        @Model.Details
                        }
                        else
                        {
                        <span class="text-muted">
                            No additional details.
                        </span>
                        }

                    </div>
                </div>

            </div>

        </div>

    </div>

</div>